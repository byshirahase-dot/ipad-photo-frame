# 大阪市立図書館 図書館カード番号とパスワード（4アカウント分）
# このファイルを .env にコピーして記入する。.env は .gitignore 済み。

OML_CARD_MOM=
OML_PASS_MOM=

OML_CARD_CHOJO=
OML_PASS_CHOJO=

OML_CARD_CHONAN=
OML_PASS_CHONAN=

OML_CARD_JINAN=
OML_PASS_JINAN=

